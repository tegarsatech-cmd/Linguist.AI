rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\\\-]+$'); }

    // --- User Profile Validation ---
    function isValidUser(data) {
      return data.email is string && data.email.size() <= 256
          && data.displayName is string && data.displayName.size() <= 128
          && (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 1024))
          && data.createdAt == request.time
          && data.keys().hasAll(['email', 'displayName', 'photoURL', 'createdAt'])
          && data.keys().size() == 4;
    }

    // --- Submission Validation ---
    function isValidSubmission(data) {
      return data.userId == request.auth.uid
          && data.type in ['writing', 'speaking']
          && data.content is string && data.content.size() <= 50000
          && data.timestamp == request.time
          && data.score is number && data.score >= 0 && data.score <= 100
          && data.feedback is map
          && data.keys().hasAll(['userId', 'type', 'content', 'score', 'feedback', 'timestamp'])
          && data.keys().size() == 6;
    }

    // --- Rules for /users/{userId} ---
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) 
                     && incoming().email == existing().email // Email is immutable
                     && incoming().createdAt == existing().createdAt; // Creation time immutable
    }

    // --- Rules for /submissions/{submissionId} ---
    match /submissions/{submissionId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidSubmission(incoming());
      // Submissions are immutable logs
      allow update, delete: if false;
    }
  }
}
